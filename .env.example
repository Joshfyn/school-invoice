# Server Configuration
PORT=8080
ENV=development
# Use ENV=staging on Render live dev, ENV=production when you go live

# Database Configuration
# Local: sslmode=disable
# Neon/Render: append ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_invoice?sslmode=disable

# Redis Configuration
# Local: redis://localhost:6379
# Upstash: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Set to false to skip auto-migrate on container start (Docker/Render)
RUN_MIGRATIONS=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Termii SMS Configuration
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=SchoolInv

# App Configuration
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
